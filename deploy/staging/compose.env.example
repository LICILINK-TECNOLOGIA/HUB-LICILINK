# Variáveis que o `docker compose` usa para montar a implantação do HUB em
# homologação.
#
# Este arquivo só lista nomes e descrições. O arquivo real fica FORA do
# repositório e é passado a todo comando com `--env-file` (roteiro em
# docs/staging-deploy.md). Nenhuma destas variáveis é segredo e nenhuma tem
# valor padrão.

# --- Sempre obrigatórias -----------------------------------------------------

# Separador da lista de COMPOSE_FILE. Use dois-pontos, para a lista não
# depender do sistema operacional.
COMPOSE_PATH_SEPARATOR=

# Conjunto de arquivos de compose desta implantação, escolhido UMA única vez.
# Define o caminho do certificado TLS:
#   certificado fixo ... só compose.staging.yml
#   ACME ............... compose.staging.yml e compose.staging.acme.yml, nessa
#                        ordem, separados por dois-pontos
# Nunca passe `-f` nos comandos: ele ignora esta variável. O shell da
# implantação também não pode ter COMPOSE_FILE exportada, porque ela
# prevaleceria sobre a deste arquivo.
COMPOSE_FILE=

# Etiqueta da imagem construída para esta implantação (por exemplo, o hash
# curto do commit).
HUB_IMAGE_TAG=

# Caminho, no VPS, do arquivo com as variáveis do contêiner (formato em
# app.env.example). Fora do repositório e com permissão restrita.
HUB_ENV_FILE=

# Nome REAL do entrypoint HTTPS do Traefik do VPS. Não é conhecido daqui.
TRAEFIK_ENTRYPOINT=

# --- Só no caminho ACME ------------------------------------------------------

# Nome REAL do resolvedor de certificados do Traefik do VPS. Obrigatória quando
# COMPOSE_FILE inclui compose.staging.acme.yml. No caminho de certificado fixo
# não é usada: deixe-a fora do arquivo.
# TRAEFIK_CERTRESOLVER=
