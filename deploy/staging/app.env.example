# Variáveis do CONTÊINER do HUB em homologação.
#
# Este arquivo só lista nomes e descrições. O arquivo real fica FORA do
# repositório, com permissão restrita, e o compose o recebe pela variável
# HUB_ENV_FILE (ver compose.env.example e docs/staging-deploy.md).
#
# Formato: NOME=valor, um por linha. Use aspas simples em valores que contenham
# o caractere de cifrão, para o Compose não tentar interpolá-los.
#
# FLASK_ENV não entra aqui: o compose.staging.yml já a define como staging.

# --- Obrigatórias: sem elas o HUB não inicia -------------------------------

# Chave que assina sessões e cookies. Mínimo de 32 caracteres, exclusiva da
# homologação, nunca reaproveitada de outro ambiente.
SECRET_KEY=

# Conexão com o PostgreSQL de homologação. Banco e usuário EXCLUSIVOS do HUB,
# mesmo dividindo o servidor com outros sistemas. Dialeto postgresql+psycopg://
# (ou postgresql://, que é normalizado). Caracteres especiais na senha precisam
# estar codificados para URL.
DATABASE_URL=

# Quantos proxies confiáveis existem entre o cliente e o HUB, para cada
# cabeçalho. Inteiros de 0 a 5, declarados separadamente. NÃO há valor padrão
# e NÃO adivinhe: o número certo depende da configuração real da Cloudflare e
# do Traefik (docs/staging-deploy.md, seção "Proxy reverso"). 0 só é aceitável
# na validação local da imagem.
HUB_PROXY_FIX_X_FOR=
HUB_PROXY_FIX_X_PROTO=

# Provedor de e-mail: resend ou console. Em homologação no VPS, o provedor
# aprovado (hoje, resend). O provedor console imprime cada e-mail inteiro, com
# o código de verificação, na saída do contêiner: só para validação local com
# dados sintéticos.
EMAIL_PROVIDER=

# URLs canônicas dos produtos. https, com host e sem credenciais. Sem valor
# padrão em homologação.
L_KALENDER_URL=
L_GEDO_URL=
L_HUNT_URL=

# --- Obrigatórias com EMAIL_PROVIDER=resend ---------------------------------

# Credencial do Resend PRÓPRIA da homologação.
RESEND_API_KEY=
# Remetente dos e-mails.
EMAIL_FROM=

# --- Opcionais --------------------------------------------------------------

# Endereço de resposta dos e-mails.
# EMAIL_REPLY_TO=

# Chave do endpoint de leads (/api/v1). Sem ela, só esse endpoint fica
# inacessível. Exclusiva da homologação.
# HUB_API_KEY=

# Ajustes com valor padrão no código (app/config.py). Nenhum é segredo.
# VERIFICATION_CODE_TTL=
# VERIFICATION_MAX_ATTEMPTS=
# VERIFICATION_RESEND_COOLDOWN=
# VERIFICATION_MAX_RESENDS=
# INSTALLATION_CREDENTIAL_ROTATION_GRACE_SECONDS=
# PRODUCT_LAUNCH_CODE_TTL_SECONDS=
