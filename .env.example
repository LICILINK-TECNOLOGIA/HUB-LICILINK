# SECRET_KEY assina sessões e cookies. O valor abaixo é apenas um placeholder
# de desenvolvimento e é explicitamente rejeitado em staging/produção.
# Em development, se a variável ficar ausente, uma chave temporária segura é
# gerada automaticamente em memória (não persistida em arquivo/log).
# Em staging/produção esta variável é OBRIGATÓRIA: defina uma chave forte e
# exclusiva (min. 32 caracteres), gerada por exemplo com
# `python -c "import secrets; print(secrets.token_hex(32))"` e armazenada
# apenas no gerenciador de segredos do ambiente (nunca neste arquivo ou no repositório).
SECRET_KEY=change-me-in-development

# DATABASE_URL configura a conexão com o PostgreSQL. O único driver instalado
# no projeto é `psycopg` (v3): use o dialeto `postgresql+psycopg://`, ou
# omita o dialeto (`postgresql://`) que ele será normalizado automaticamente.
# Qualquer outro dialeto explícito (ex.: postgresql+psycopg2://,
# postgresql+asyncpg://) é rejeitado, pois o driver correspondente não está
# instalado.
# Se ausente em development, é usado o padrão local:
# postgresql+psycopg://hub_user:hub_password@localhost:5433/hub_db
# (mesmas credenciais do serviço `db` em docker-compose.dev.yml; a porta 5433
# é a publicada no host — o compose só sobe o PostgreSQL, o Flask roda no host).
# Em staging/produção esta variável é OBRIGATÓRIA: a aplicação falha ao
# iniciar, de forma clara, caso esteja ausente.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco

L_KALENDER_URL=https://[URL_DO_L_KALENDER]
L_GEDO_URL=https://[URL_DO_L_GEDO]

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
