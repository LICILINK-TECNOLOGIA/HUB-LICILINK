# SECRET_KEY assina sessões e cookies. O valor abaixo é apenas um placeholder
# de desenvolvimento e é explicitamente rejeitado em staging/produção.
# Em development, se a variável ficar ausente, uma chave temporária segura é
# gerada automaticamente em memória (não persistida em arquivo/log).
# Em staging/produção esta variável é OBRIGATÓRIA: defina uma chave forte e
# exclusiva (min. 32 caracteres), gerada por exemplo com
# `python -c "import secrets; print(secrets.token_hex(32))"` e armazenada
# apenas no gerenciador de segredos do ambiente (nunca neste arquivo ou no repositório).
SECRET_KEY=change-me-in-development

L_KALENDER_URL=https://[URL_DO_L_KALENDER]
L_GEDO_URL=https://[URL_DO_L_GEDO]

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
